import time

def say (text,pause):
    for letter in text:
        print(letter,end='',flush=True)
        time.sleep(0.03)
    print()
    time.sleep(pause)

def thinking(thinking_text='', seconds=3):
    cycles = 3
    pause = seconds / (cycles * 3)
    for i in range(cycles):
        print('\r' + thinking_text, end='', flush=True)
        for i in range(3):
            time.sleep(pause)
            print('.', end='', flush=True)
        time.sleep(pause)
        print('\r' + ' ' * (len(thinking_text) + 3) + '\r', end='', flush=True)

